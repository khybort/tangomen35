{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tangomen35",
	"main": "worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [
		{ "pattern": "tangomen35.com", "custom_domain": true },
		{ "pattern": "www.tangomen35.com", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tangomen35"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tangomen35",
			"database_id": "a09d7e4e-472a-41ff-a392-6a3ee385a79f",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
